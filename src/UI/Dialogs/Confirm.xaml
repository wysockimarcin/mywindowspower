<!-- Okno potwierdzenia z „Podglądem zmian" (ARCHITEKTURA.md, „Zasady bezpieczeństwa zmian"; D-027).
     Zawsze pokazuje komputer docelowy; operacja Destrukcyjna może wymagać wpisania nazwy celu. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Potwierdzenie" Width="620" SizeToContent="Height" MaxHeight="760" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource Mwp.Brush.Surface}" Foreground="{DynamicResource Mwp.Brush.Text}"
        FontFamily="{DynamicResource Mwp.Font.Text}" FontSize="14">
    <DockPanel Margin="24,20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ConfirmButton" Style="{StaticResource Mwp.Button.Accent}" Content="Wykonaj" MinWidth="110" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="Anuluj" MinWidth="110" IsCancel="True" IsDefault="True"/>
        </StackPanel>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="440"/>
                <Border x:Name="ClassBadge" Style="{StaticResource Mwp.StateBadge}" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Label}"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="TargetText" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock x:Name="ComputerText" Style="{StaticResource Mwp.Text.Muted}" Margin="0,4,0,0"/>

            <TextBlock Text="Podgląd zmian" Style="{StaticResource Mwp.Text.Label}" Margin="0,16,0,4"/>
            <Border BorderBrush="{DynamicResource Mwp.Brush.Border}" BorderThickness="1" CornerRadius="6"
                    Background="{DynamicResource Mwp.Brush.SurfaceAlt}" Padding="10,8">
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PreviewList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" FontFamily="Consolas" FontSize="13"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border x:Name="WarningBanner" Style="{StaticResource Mwp.Banner.Warning}" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap"/>
            </Border>

            <StackPanel x:Name="TypedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock x:Name="TypedLabel" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBox x:Name="TypedBox"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>

<!-- Okno poświadczeń dla komputera zdalnego (D-034, D-052): hasło jako SecureString; zapis w Menedżerze poświadczeń Windows tylko po zaznaczeniu pola (domyślnie wyłączone). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poświadczenia" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource Mwp.Brush.Surface}" Foreground="{DynamicResource Mwp.Brush.Text}"
        FontFamily="{DynamicResource Mwp.Font.Text}" FontSize="14">
    <StackPanel Margin="24,20">
        <TextBlock Text="Połączenie z komputerem zdalnym" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="ComputerText" Style="{StaticResource Mwp.Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="NoticeText" Foreground="{DynamicResource Mwp.Brush.WarningText}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
        <TextBlock Text="Konto (np. KOMPUTER\administrator)" Style="{StaticResource Mwp.Text.Label}"/>
        <TextBox x:Name="UserBox"/>
        <TextBlock Text="Hasło" Style="{StaticResource Mwp.Text.Label}"/>
        <PasswordBox x:Name="PasswordInput"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Mwp.Brush.Danger}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        <StackPanel x:Name="SavePanel" Margin="0,14,0,0" Visibility="Collapsed">
            <CheckBox x:Name="SaveCheck" IsChecked="False" Content="Zapamiętaj w Menedżerze poświadczeń Windows"/>
            <TextBlock Style="{StaticResource Mwp.Text.Muted}" FontSize="12" TextWrapping="Wrap" Margin="22,4,0,0"
                       Text="Hasło zostanie zapisane dopiero po udanym połączeniu, jako wpis MWP:&lt;komputer&gt; tylko na tym komputerze. Może je odczytać każdy program działający na Twoim koncie Windows (jak zapisane hasła pulpitu zdalnego) — używaj osobnego konta lokalnego administratora z unikalnym hasłem. Usuniesz je przyciskiem „Zapomnij hasło” w edytorze komputera albo w Panelu sterowania → Menedżer poświadczeń → Poświadczenia systemu Windows."/>
        </StackPanel>
        <TextBlock Style="{StaticResource Mwp.Text.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="Bez zapamiętania hasło jest tylko w pamięci aplikacji do jej zamknięcia (wspólne dla instancji i widgetów tego komputera) i znika po odmowie dostępu."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Style="{StaticResource Mwp.Button.Accent}" Content="Połącz" MinWidth="110" Margin="0,0,8,0" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Anuluj" MinWidth="110" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

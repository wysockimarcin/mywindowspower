<!-- Osobne okno instancji modułu (tryb SeparateWindow). Treścią jest ten sam widok co w oknie głównym. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="680" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource Mwp.Brush.WindowBackground}" Foreground="{DynamicResource Mwp.Brush.Text}"
        FontFamily="{DynamicResource Mwp.Font.Text}" FontSize="14">
    <Border Style="{StaticResource Mwp.Card}" Margin="12" Padding="0">
        <ContentControl x:Name="Host" Focusable="False"/>
    </Border>
</Window>

<!-- Dodawanie i edycja komputera docelowego (Add-MwpTarget, Set-MwpTarget). Bez pola hasła (D-034). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Komputer docelowy" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource Mwp.Brush.Surface}" Foreground="{DynamicResource Mwp.Brush.Text}"
        FontFamily="{DynamicResource Mwp.Font.Text}" FontSize="14">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Nazwa komputera (NetBIOS/DNS) albo adres IPv4" Style="{StaticResource Mwp.Text.Label}"/>
        <TextBox x:Name="NameBox"/>
        <TextBlock Text="Nazwa wyświetlana" Style="{StaticResource Mwp.Text.Label}"/>
        <TextBox x:Name="DisplayNameBox"/>
        <TextBlock Text="Uwierzytelnienie" Style="{StaticResource Mwp.Text.Label}"/>
        <ComboBox x:Name="AuthCombo">
            <ComboBoxItem Content="Poświadczenia podawane przy połączeniu (Credential)" Tag="Credential"/>
            <ComboBoxItem Content="Konto, na którym działa aplikacja (CurrentUser)" Tag="CurrentUser"/>
        </ComboBox>
        <TextBlock Text="Konto — tylko podpowiedź, bez hasła (np. KOMPUTER\administrator)" Style="{StaticResource Mwp.Text.Label}"/>
        <TextBox x:Name="UserBox"/>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Port WinRM" Style="{StaticResource Mwp.Text.Label}" Margin="0,0,0,3"/>
                <TextBox x:Name="PortBox" Width="100" HorizontalAlignment="Left"/>
            </StackPanel>
            <CheckBox x:Name="SslCheck" Grid.Column="1" Content="HTTPS (port 5986)" ToolTip="Wymaga certyfikatu na komputerze zdalnym; bez wpisu w TrustedHosts." VerticalAlignment="Bottom" Margin="0,0,0,6"/>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Mwp.Brush.Danger}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Style="{StaticResource Mwp.Button.Accent}" Content="Dalej…" MinWidth="110" Margin="0,0,8,0" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Anuluj" MinWidth="110" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

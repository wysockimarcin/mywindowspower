<!-- Wybór komputera docelowego i trybu prezentacji dla nowej instancji modułu (wspólny komponent, D-019). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nowa instancja modułu" Width="560" Height="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource Mwp.Brush.Surface}" Foreground="{DynamicResource Mwp.Brush.Text}"
        FontFamily="{DynamicResource Mwp.Font.Text}" FontSize="14">
    <DockPanel Margin="24,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Nowa instancja modułu" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="ModuleText" Style="{StaticResource Mwp.Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Komputer docelowy" Style="{StaticResource Mwp.Text.Label}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="Miejsce prezentacji" Style="{StaticResource Mwp.Text.Label}"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeEmbedded" Content="W oknie głównym" GroupName="Mode" IsChecked="True"/>
                <RadioButton x:Name="ModeSeparate" Content="W osobnym oknie" GroupName="Mode"/>
            </StackPanel>
            <CheckBox x:Name="ConnectCheck" Content="Połącz od razu (komputer zdalny)" IsChecked="True" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="OkButton" Style="{StaticResource Mwp.Button.Accent}" Content="Otwórz" MinWidth="110" Margin="0,0,8,0" IsDefault="True"/>
                <Button x:Name="CancelButton" Content="Anuluj" MinWidth="110" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="TargetList" Background="{DynamicResource Mwp.Brush.SurfaceAlt}" BorderBrush="{DynamicResource Mwp.Brush.Border}"
                 Foreground="{DynamicResource Mwp.Brush.Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Mwp.NavItem}">
                    <Setter Property="IsEnabled" Value="{Binding Allowed}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>

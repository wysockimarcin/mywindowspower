<!-- Dodawanie i edycja widgetu Dashboardu (D-043): rodzaj widgetu, komputer, nazwa, odświeżanie, rozmiar, parametry.
     Listy z ItemTemplate (nie DisplayMemberPath): szablon ComboBox w Styles.xaml pokazuje wybrany element przez SelectionBoxItemTemplate. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget Dashboardu" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource Mwp.Brush.Surface}" Foreground="{DynamicResource Mwp.Brush.Text}"
        FontFamily="{DynamicResource Mwp.Font.Text}" FontSize="14">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Rodzaj widgetu" Style="{StaticResource Mwp.Text.Label}"/>
        <ComboBox x:Name="WidgetCombo">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock x:Name="WidgetDescription" Style="{StaticResource Mwp.Text.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock Text="Komputer docelowy" Style="{StaticResource Mwp.Text.Label}"/>
        <ComboBox x:Name="TargetCombo">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Nazwa widgetu (opcjonalnie)" Style="{StaticResource Mwp.Text.Label}"/>
        <TextBox x:Name="TitleBox"/>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Odświeżanie" Style="{StaticResource Mwp.Text.Label}"/>
                <ComboBox x:Name="RefreshCombo">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Rozmiar kafelka" Style="{StaticResource Mwp.Text.Label}"/>
                <ComboBox x:Name="SizeCombo">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ParametersHeader" Text="Parametry" Style="{StaticResource Mwp.Text.Label}"/>
        <StackPanel x:Name="ParametersPanel"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Mwp.Brush.Danger}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Style="{StaticResource Mwp.Button.Accent}" Content="Zapisz" MinWidth="110" Margin="0,0,8,0" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Anuluj" MinWidth="110" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

<!-- Wspólne style hosta (FAZA 4). Kolory wyłącznie przez DynamicResource z Light.xaml / Dark.xaml,
     więc zmiana motywu nie wymaga ponownego tworzenia okien. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Mwp.Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Mwp.Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Tekst -->
    <Style x:Key="Mwp.Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Mwp.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Mwp.Text.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="Margin" Value="0,20,0,8"/>
    </Style>
    <Style x:Key="Mwp.Text.Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Mwp.Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.TextMuted}"/>
        <Setter Property="Margin" Value="0,10,0,3"/>
    </Style>
    <Style x:Key="Mwp.Text.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Mwp.Font.Icons}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Karty i banery -->
    <Style x:Key="Mwp.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mwp.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="Mwp.Banner.Warning" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.WarningBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mwp.Brush.WarningBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Mwp.Brush.WarningText}"/>
    </Style>
    <Style x:Key="Mwp.Banner.Info" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.InfoBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mwp.Brush.InfoBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Mwp.Brush.InfoText}"/>
    </Style>
    <Style x:Key="Mwp.Banner.Danger" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.DangerBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mwp.Brush.Danger}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
    </Style>
    <Style x:Key="Mwp.Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.NeutralBackground}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="9,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Mwp.Brush.Neutral}"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
    </Style>

    <!-- Plakietka stanu: DataContext z polami Label i Tone (Success, Info, Warning, Danger, Neutral). -->
    <Style x:Key="Mwp.StateBadge" TargetType="Border" BasedOn="{StaticResource Mwp.Badge}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Mwp.Brush.SuccessBackground}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Mwp.Brush.Success}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Info">
                <Setter Property="Background" Value="{DynamicResource Mwp.Brush.InfoBackground}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Mwp.Brush.InfoText}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Mwp.Brush.WarningBackground}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Mwp.Brush.WarningText}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource Mwp.Brush.DangerBackground}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Mwp.Brush.Danger}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Przyciski -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.Button}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mwp.Brush.InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mwp.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Mwp.Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mwp.Brush.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Mwp.Button.Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.AccentText}"/>
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mwp.Brush.Accent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Mwp.Brush.AccentHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Mwp.Button.Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Surface}"/>
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.Danger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mwp.Brush.Danger}"/>
    </Style>
    <Style x:Key="Mwp.Button.Subtle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- Zakładki (widoki modułów, np. Autostart i harmonogram) -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,12,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Mwp.Brush.Border}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True"/>
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.TextMuted}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mwp.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Mwp.Brush.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pola edycji -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mwp.Brush.InputBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Mwp.Brush.Accent}"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mwp.Brush.InputBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="Margin" Value="0,4,16,4"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mwp.Brush.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mwp.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mwp.Brush.InputBorder}"/>
        <Setter Property="Padding" Value="8,5,30,5"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="1" CornerRadius="4">
                                        <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource Mwp.Font.Icons}" FontSize="10"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource Mwp.Brush.TextMuted}"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Mwp.Brush.Surface}" BorderBrush="{DynamicResource Mwp.Brush.Border}"
                                    BorderThickness="1" CornerRadius="4" Margin="0,2,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tabele -->
    <Style TargetType="DataGrid">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.Surface}"/>
        <Setter Property="RowBackground" Value="{DynamicResource Mwp.Brush.Surface}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Mwp.Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mwp.Brush.Border}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Mwp.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.TextMuted}"/>
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mwp.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="8,5">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Mwp.Brush.Selected}"/>
                <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Nawigacja -->
    <Style x:Key="Mwp.NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style x:Key="Mwp.NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="6,1">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="12,8">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{DynamicResource Mwp.Brush.Accent}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mwp.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mwp.Brush.Selected}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.TextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Paski przewijania w kolorach motywu (domyślne paski WPF są jasne także w motywie ciemnym). -->
    <Style x:Key="Mwp.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Mwp.Brush.InputBorder}" CornerRadius="3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Mwp.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Mwp.ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Mwp.ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Mwp.ScrollThumb}" Margin="2"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Mwp.ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Mwp.ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Mwp.ScrollThumb}" Margin="2"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.NeutralBackground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="6"/>
    </Style>
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.Border}"/>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Mwp.Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Mwp.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mwp.Brush.Border}"/>
    </Style>
</ResourceDictionary>

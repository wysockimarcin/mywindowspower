<!-- Pulpit: zaślepka Dashboardu (widgety — FAZA 5). Pokazuje komputery docelowe i otwarte instancje. -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Pulpit" Style="{StaticResource Mwp.Text.Title}"/>
                    <TextBlock x:Name="Summary" Style="{StaticResource Mwp.Text.Subtitle}"/>
                </StackPanel>
                <Button x:Name="AddTargetButton" DockPanel.Dock="Right" Style="{StaticResource Mwp.Button.Accent}"
                        Content="+ Dodaj komputer" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Style="{StaticResource Mwp.Banner.Info}" Margin="0,20,0,0">
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="Dashboard z widgetami powstanie w FAZIE 5."/>
                    <Run Text="Teraz pulpit pokazuje komputery docelowe i otwarte instancje modułów. Instancję otwierasz z widoku obszaru w nawigacji."/>
                </TextBlock>
            </Border>

            <TextBlock Text="Komputery" Style="{StaticResource Mwp.Text.Section}"/>
            <ItemsControl x:Name="TargetsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Mwp.Card}" Width="300" Margin="0,0,14,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Mwp.Text.Muted}"/>
                                <TextBlock Text="{Binding Connection}" Style="{StaticResource Mwp.Text.Muted}" FontSize="12" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding Instances}" Style="{StaticResource Mwp.Text.Muted}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Otwarte instancje" Style="{StaticResource Mwp.Text.Section}"/>
            <TextBlock x:Name="NoInstancesText" Style="{StaticResource Mwp.Text.Muted}"
                       Text="Brak otwartych instancji. Wybierz obszar w nawigacji i kliknij „Otwórz instancję”."/>
            <ItemsControl x:Name="InstancesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Mwp.Card}" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Uid="Show" Tag="{Binding Id}" Content="Pokaż" Margin="0,0,8,0"/>
                                    <Button Uid="Close" Tag="{Binding Id}" Content="Zamknij"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border Style="{StaticResource Mwp.StateBadge}" DataContext="{Binding State}">
                                        <TextBlock Text="{Binding Label}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Placement}" Style="{StaticResource Mwp.Text.Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

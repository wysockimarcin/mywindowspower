<!-- Widok „Moduły" (D-031): moduły wbudowane i z paczek, instalacja z .mwpmod, odinstalowanie; ustawienia widżetów modułu (D-053). -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,28">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Moduły" Style="{StaticResource Mwp.Text.Title}"/>
            <TextBlock x:Name="Summary" Style="{StaticResource Mwp.Text.Subtitle}"/>

            <Border x:Name="LegacyBanner" Style="{StaticResource Mwp.Banner.Warning}" Margin="0,16,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="LegacyMoveButton" DockPanel.Dock="Right" Content="Przenieś do katalogu danych" Margin="12,0,0,0"/>
                    <TextBlock x:Name="LegacyText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <WrapPanel Margin="0,16,0,12">
                <Button x:Name="InstallButton" Style="{StaticResource Mwp.Button.Accent}" Content="Zainstaluj z pliku .mwpmod…" Margin="0,0,8,0"/>
                <Button x:Name="UninstallButton" Style="{StaticResource Mwp.Button.Danger}" Content="Odinstaluj" Margin="0,0,8,0" IsEnabled="False"/>
                <Button x:Name="RefreshButton" Content="Odśwież"/>
            </WrapPanel>
        </StackPanel>

        <!-- Sekcja „Widżety” (D-053): widoczność typów widgetów modułu na liście „Dodaj widżet” i domyślne parametry nowych widgetów. -->
        <Border x:Name="WidgetsCard" DockPanel.Dock="Bottom" Style="{StaticResource Mwp.Card}" Margin="0,12,0,0" Padding="14,10" Visibility="Collapsed">
            <StackPanel>
                <DockPanel>
                    <CheckBox x:Name="ModuleWidgetsCheck" DockPanel.Dock="Right" Content="Moduł dostępny jako widżet" VerticalAlignment="Center"/>
                    <TextBlock Text="Widżety" Style="{StaticResource Mwp.Text.Section}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Mwp.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,8"
                           Text="Ukrycie typu usuwa go tylko z listy „Dodaj widżet”: widżety już dodane na Pulpit zostają i działają. Domyślne parametry dotyczą nowych widżetów; zmiany zapisują się od razu."/>
                <DockPanel>
                    <Button x:Name="WidgetResetButton" DockPanel.Dock="Right" Content="Przywróć domyślne" Margin="8,0,0,0"/>
                    <ComboBox x:Name="WidgetTypeCombo" DisplayMemberPath="Title"/>
                </DockPanel>
                <TextBlock x:Name="WidgetDescriptionText" Style="{StaticResource Mwp.Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <CheckBox x:Name="WidgetVisibleCheck" Content="Pokazuj na liście „Dodaj widżet”" Margin="0,8,0,0"/>
                <TextBlock x:Name="WidgetParametersHeader" Text="Domyślne parametry nowych widżetów" Style="{StaticResource Mwp.Text.Label}" Margin="0,10,0,0"/>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="WidgetParametersPanel"/>
                </ScrollViewer>
                <TextBlock x:Name="WidgetStatusText" Style="{StaticResource Mwp.Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Mwp.Card}" Margin="0,12,0,0" Padding="14,10">
            <TextBlock x:Name="DetailsText" Style="{StaticResource Mwp.Text.Muted}" TextWrapping="Wrap"
                       Text="Wybierz moduł, żeby zobaczyć szczegóły."/>
        </Border>

        <DataGrid x:Name="ModulesGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="Wersja" Binding="{Binding Version}" Width="70"/>
                <DataGridTextColumn Header="Pochodzenie" Binding="{Binding Source}" Width="100"/>
                <DataGridTextColumn Header="Stan" Binding="{Binding State}" Width="2*"/>
                <DataGridTextColumn Header="Tryby" Binding="{Binding Modes}" Width="*"/>
                <DataGridTextColumn Header="Uprawnienia" Binding="{Binding Permissions}" Width="*"/>
                <DataGridTextColumn Header="Instancje" Binding="{Binding Instances}" Width="75"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

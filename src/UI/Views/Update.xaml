<!-- Widok modułu Windows Update (FAZA 10, D-048): stan (usługi, restart, pauza), wyszukiwanie oczekujących aktualizacji (COM)
     w tle, instalacja zaznaczonych (tylko komputer lokalny, potwierdzenie, postęp i anulowanie), pauza 1–5 tygodni i wznowienie,
     reset składników z podglądem kroków, historia aktualizacji i zmiany do cofnięcia. Wstawiany do widoku instancji
     (Instance.xaml, ModuleHost). Kod: Initialize-/Update-MwpUpdateView. -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="OptionTemplate">
            <TextBlock Text="{Binding Label}"/>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,4,0,0" LastChildFill="True">
            <Button x:Name="UpdateRefreshButton" DockPanel.Dock="Right" Content="Odśwież stan" VerticalAlignment="Center"/>
            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Mwp.Text.Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Odczyt stanu Windows Update…"/>
        </DockPanel>
        <Border x:Name="UpdateWarningBanner" Style="{StaticResource Mwp.Banner.Warning}" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="UpdateWarningText" TextWrapping="Wrap"/>
        </Border>

        <Border Style="{StaticResource Mwp.Card}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="UpdateRebootText" FontWeight="SemiBold" TextWrapping="Wrap" Text="—"/>
                <TextBlock x:Name="UpdateSummaryText" Style="{StaticResource Mwp.Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Usługi Windows Update" Style="{StaticResource Mwp.Text.Section}"/>
        <DataGrid x:Name="UpdateServicesGrid" MinHeight="60" MaxHeight="180" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Usługa" Binding="{Binding DisplayName}" Width="3*"/>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Stan" Binding="{Binding StatusText}" Width="110"/>
                <DataGridTextColumn Header="Typ uruchomienia" Binding="{Binding StartupTypeText}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Style="{StaticResource Mwp.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Uruchamianie, zatrzymywanie i typ uruchomienia usług — w module Usługi Windows."/>

        <TextBlock Text="Oczekujące aktualizacje" Style="{StaticResource Mwp.Text.Section}"/>
        <WrapPanel>
            <ComboBox x:Name="UpdateTypeBox" Width="200" Margin="0,0,8,8" ItemTemplate="{StaticResource OptionTemplate}"/>
            <Button x:Name="UpdateSearchButton" Content="Wyszukaj aktualizacje" Margin="0,0,8,8"/>
            <Button x:Name="UpdateInstallButton" Style="{StaticResource Mwp.Button.Accent}" Content="Zainstaluj zaznaczone…" Margin="0,0,8,8"/>
            <Button x:Name="UpdateSettingsButton" Content="Otwórz Ustawienia Windows Update" Margin="0,0,8,8"/>
            <TextBlock x:Name="UpdateSelectionText" Style="{StaticResource Mwp.Text.Muted}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
        </WrapPanel>
        <TextBlock x:Name="UpdateSearchText" Style="{StaticResource Mwp.Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="Wyszukiwanie łączy się z serwerem aktualizacji i trwa zwykle od kilkunastu sekund do kilku minut; niczego nie pobiera."/>
        <Border x:Name="UpdateProgressPanel" Style="{StaticResource Mwp.Card}" Margin="0,4,0,8" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button x:Name="UpdateCancelButton" DockPanel.Dock="Right" Content="Anuluj" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel>
                    <TextBlock x:Name="UpdateProgressText" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="UpdateProgressBar" Height="6" Maximum="100" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <DataGrid x:Name="UpdatesGrid" MinHeight="100" MaxHeight="360" SelectionMode="Extended" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Aktualizacja" Binding="{Binding Title}" Width="4*"/>
                <DataGridTextColumn Header="KB" Binding="{Binding KBText}" Width="100"/>
                <DataGridTextColumn Header="Rodzaj" Binding="{Binding TypeText}" Width="110"/>
                <DataGridTextColumn Header="Ważność" Binding="{Binding SeverityText}" Width="100"/>
                <DataGridTextColumn Header="Rozmiar" Binding="{Binding SizeText}" Width="90"/>
                <DataGridTextColumn Header="Pobrana" Binding="{Binding DownloadedText}" Width="70"/>
                <DataGridTextColumn Header="Restart" Binding="{Binding RebootText}" Width="80"/>
                <DataGridTextColumn Header="Uwagi" Binding="{Binding Note}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Style="{StaticResource Mwp.Card}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="UpdateDetailTitle" FontWeight="SemiBold" TextWrapping="Wrap" Text="Wybierz aktualizację z listy (Ctrl lub Shift — kilka)."/>
                <TextBlock x:Name="UpdateDetailText" Style="{StaticResource Mwp.Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Text="Wynik ostatniej instalacji" Style="{StaticResource Mwp.Text.Section}"/>
        <TextBox x:Name="UpdateInstallReportText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                 Text="Brak — wynik pojawi się po instalacji."/>

        <TextBlock Text="Pauza aktualizacji" Style="{StaticResource Mwp.Text.Section}"/>
        <TextBlock Style="{StaticResource Mwp.Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Te same ustawienia, które zapisuje przycisk „Wstrzymaj” w Ustawieniach Windows 11 (od 1 do 5 tygodni). Wymaga administratora. Każda zmiana ma wpis cofnięcia."/>
        <WrapPanel>
            <TextBlock x:Name="UpdatePauseText" VerticalAlignment="Center" Margin="0,0,12,8" TextWrapping="Wrap"/>
            <ComboBox x:Name="UpdatePauseWeeksBox" Width="140" Margin="0,0,8,8" ItemTemplate="{StaticResource OptionTemplate}"/>
            <Button x:Name="UpdatePauseButton" Content="Wstrzymaj…" Margin="0,0,8,8"/>
            <Button x:Name="UpdateResumeButton" Content="Wznów…" Margin="0,0,8,8"/>
        </WrapPanel>

        <TextBlock Text="Reset składników Windows Update" Style="{StaticResource Mwp.Text.Section}"/>
        <TextBlock Style="{StaticResource Mwp.Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Naprawa uszkodzonej pamięci Windows Update: zatrzymanie usług, zmiana nazw folderów SoftwareDistribution i catroot2 (stare foldery zostają z sufiksem .mwp-data), ponowne uruchomienie usług. Wymaga administratora; przed wykonaniem okno pokazuje wszystkie kroki. Cofnięcie przywraca stare foldery."/>
        <WrapPanel>
            <Button x:Name="UpdateResetButton" Style="{StaticResource Mwp.Button.Danger}" Content="Resetuj składniki…" Margin="0,0,8,8"/>
            <TextBlock x:Name="UpdateBackupText" Style="{StaticResource Mwp.Text.Muted}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
        </WrapPanel>

        <TextBlock Text="Historia aktualizacji" Style="{StaticResource Mwp.Text.Section}"/>
        <WrapPanel>
            <Button x:Name="UpdateHistoryButton" Content="Wczytaj historię" Margin="0,0,8,8"/>
            <CheckBox x:Name="UpdateHistoryFailedCheck" Content="Tylko niepowodzenia" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <TextBlock x:Name="UpdateHistoryText" Style="{StaticResource Mwp.Text.Muted}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
        </WrapPanel>
        <DataGrid x:Name="UpdateHistoryGrid" MinHeight="80" MaxHeight="320" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding DateText}" Width="130"/>
                <DataGridTextColumn Header="Operacja" Binding="{Binding OperationText}" Width="110"/>
                <DataGridTextColumn Header="Wynik" Binding="{Binding ResultText}" Width="150"/>
                <DataGridTextColumn Header="KB" Binding="{Binding KBText}" Width="100"/>
                <DataGridTextColumn Header="Aktualizacja" Binding="{Binding Title}" Width="4*"/>
                <DataGridTextColumn Header="Kod błędu" Binding="{Binding ErrorText}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Zmiany Windows Update do cofnięcia (ten komputer)" Style="{StaticResource Mwp.Text.Section}"/>
        <DataGrid x:Name="UpdateUndoGrid" MinHeight="60" MaxHeight="200" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kiedy" Binding="{Binding When}" Width="140"/>
                <DataGridTextColumn Header="Zmiana" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Margin="0,10,0,0">
            <Button x:Name="UpdateUndoButton" Content="Cofnij wybraną…" Margin="0,0,8,8"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
